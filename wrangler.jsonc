{
	"name": "my-project",
	"compatibility_date": "2026-02-08",
	"main": "worker.js",
	"assets": {
		"directory": "./",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"vars": {
		"REQUIRE_ACCESS": "true",
		"ALLOWED_EMAILS": "zachdmartens@gmail.com",
		// Zero Trust team name. Issuer is https://<this>.cloudflareaccess.com
		"ACCESS_TEAM_DOMAIN": "broad-fire-9fe2",
		// AUD tag of the "Bucket List sign-in" Access application. worker.js validates every
		// gated path against this single audience, so one login also covers PP30, whose API
		// had been returning 401 to everything while this was empty.
		"ACCESS_AUD": "f6dc1b6121715a8c4ed8e6c9e580eaa679ccea5d33cd119ba76a63281e721f30"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pp30-tracker",
			"database_id": "034a4657-ba7b-4850-931b-db23ce6f29da",
			"migrations_dir": "projects/MTNTOUGH PP30/migrations",
			"remote": true
		}
	]
}
